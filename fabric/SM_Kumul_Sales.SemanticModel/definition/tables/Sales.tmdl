table Sales
	lineageTag: cc37a3e7-af7e-4bed-b692-6d36bd825c38
	sourceLineageTag: [fact].[Sales]

	/// Revenue in AUD at monthly FX rate, excluding cancelled orders. Returns reduce revenue.
	measure 'Sales AUD' = CALCULATE ( SUM ( Sales[SalesAmountAUD] ), KEEPFILTERS ( Sales[OrderStatus] <> "Cancelled" ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Measures\Sales
		lineageTag: 8c00aac3-7dd8-462e-9064-fe1314567f98

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Cost of goods in AUD (quantity × current unit cost), excluding cancelled orders.
	measure 'Cost AUD' = CALCULATE ( SUM ( Sales[CostAmountAUD] ), KEEPFILTERS ( Sales[OrderStatus] <> "Cancelled" ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Measures\Sales
		lineageTag: 6a3c19f3-fd9f-427f-97f7-b6be94ac9d4d

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Value of returned goods in AUD, shown as a positive number.
	measure 'Returns AUD' = CALCULATE ( -[Sales AUD], KEEPFILTERS ( Sales[IsReturn] = TRUE () ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Measures\Sales
		lineageTag: 07fbde4e-d510-4d15-8bab-2283ed61ae67

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Count of distinct orders, excluding cancelled.
	measure Orders = CALCULATE ( DISTINCTCOUNT ( Sales[SalesOrderID] ), KEEPFILTERS ( Sales[OrderStatus] <> "Cancelled" ) )
		formatString: #,0
		displayFolder: Measures\Sales
		lineageTag: 1fcb98ca-b068-4454-a88e-8dafd3c442c2

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	/// Total quantity sold, excluding cancelled orders.
	measure Units = CALCULATE ( SUM ( Sales[Quantity] ), KEEPFILTERS ( Sales[OrderStatus] <> "Cancelled" ) )
		formatString: #,0
		displayFolder: Measures\Sales
		lineageTag: b780908a-4308-4ae2-b164-85095e41bdd4

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	/// Average AUD revenue per order.
	measure 'Avg Order Value AUD' = DIVIDE ( [Sales AUD], [Orders] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Measures\Sales
		lineageTag: 534a11c9-1cb0-4ff7-b885-8f77870f436c

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Sales AUD minus Cost AUD.
	measure 'Gross Margin AUD' = [Sales AUD] - [Cost AUD]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Measures\Margin
		lineageTag: 227a4637-4ee5-49b7-bf6f-5101f4a2fd35

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Gross margin as a share of sales.
	measure 'Gross Margin %' = DIVIDE ( [Gross Margin AUD], [Sales AUD] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Measures\Margin
		lineageTag: 4d59724b-b1d1-4fa9-849d-f44c2fa527f8

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	/// Sales AUD for the same period last year.
	measure 'Sales AUD PY' = IF ( ISBLANK ( [Sales AUD] ), BLANK (), CALCULATE ( [Sales AUD], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Measures\Time Intelligence
		lineageTag: f9343b59-9842-4e25-b6d3-7b1444b514d0

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Change in Sales AUD versus the same period last year.
	measure 'Sales YoY %' = IF ( [PY Comparable], DIVIDE ( [Sales AUD] - [Sales AUD PY], [Sales AUD PY] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Measures\Time Intelligence
		lineageTag: 37bdd31b-755e-4458-b53a-e7b86f4826d6

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	/// Sales AUD year-to-date, Australian financial year (July–June).
	measure 'Sales AUD FYTD' = TOTALYTD ( [Sales AUD], 'Date'[Date], "6/30" )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Measures\Time Intelligence
		lineageTag: 02017474-0318-4eab-bc1b-d8c655f7a268

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Sales AUD by ship date rather than order date.
	measure 'Sales Shipped AUD' = CALCULATE ( [Sales AUD], USERELATIONSHIP ( Sales[ShippedDateKey], 'Date'[DateKey] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Measures\Operations
		lineageTag: 70b49aed-bd85-491a-b806-a01fd122a82c

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Share of shipped orders that shipped on or before the required date.
	measure 'On-Time Ship %' = VAR ShippedOrders = CALCULATE ( DISTINCTCOUNT ( Sales[SalesOrderID] ), NOT ISBLANK ( Sales[IsShippedLate] ) ) VAR OnTimeOrders = CALCULATE ( DISTINCTCOUNT ( Sales[SalesOrderID] ), Sales[IsShippedLate] == FALSE () ) RETURN DIVIDE ( OnTimeOrders, ShippedOrders )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Measures\Operations
		lineageTag: 116a3036-cc17-4b00-81ee-431b08f469ee

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	/// Average days from order to shipment, per order.
	measure 'Avg Days to Ship' = AVERAGEX ( VALUES ( Sales[SalesOrderID] ), CALCULATE ( MAX ( Sales[DaysToShip] ) ) )
		formatString: #,0.0
		displayFolder: Measures\Operations
		lineageTag: b6459b99-b295-4fd0-a609-16fac062a12f

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	measure 'PY Comparable' =
			
			VAR MonthsCurrent = COUNTROWS ( FILTER ( VALUES ( 'Date'[MonthStart] ), [Sales AUD] > 0 ) )
			VAR MonthsPrior   = COUNTROWS ( FILTER ( VALUES ( 'Date'[MonthStart] ), [Sales AUD PY] > 0 ) )
			RETURN HASONEVALUE ( 'Date'[AUFinancialYear] ) && MonthsCurrent = MonthsPrior
		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: Measures\Time Intelligence
		lineageTag: 98caabbf-933e-42a9-ad06-6db058fcfdd6

		changedProperty = Name

		changedProperty = DisplayFolder

